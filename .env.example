# ==========================================
# EZZZY GAME BOT
# ==========================================

# Токен Telegram-бота от @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# Telegram ID владельца бота
OWNER_ID=PASTE_YOUR_TELEGRAM_ID_HERE

# ==========================================
# DATABASE
# ==========================================

# Локальная разработка — SQLite
DATABASE_URL=sqlite+aiosqlite:///./data/ezzzy.db

# Для PostgreSQL на VDS потом будет примерно:
# DATABASE_URL=postgresql+asyncpg://USER:PASSWORD@HOST:5432/DATABASE

# ==========================================
# LOGGING
# ==========================================

LOG_LEVEL=INFO

# ==========================================
# MESSAGE ECONOMY
# ==========================================

MESSAGE_REWARD_MIN=1
MESSAGE_REWARD_MAX=5

# XP за сообщение
MESSAGE_XP=1

# Как часто одно сообщение может приносить арахис
MESSAGE_REWARD_COOLDOWN=60

# ==========================================
# DAILY BONUS
# ==========================================

DAILY_BONUS_MIN=100
DAILY_BONUS_MAX=500

# ==========================================
# BET LIMITS
# ==========================================

MIN_BET=10
MAX_BET=1000000